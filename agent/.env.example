# Room Configuration (WAJIB)
# Setiap PC ruangan punya ROOM_ID berbeda. Harus sama dengan entry di cashier VITE_ROOMS.
ROOM_ID=room-001
ROOM_NAME=Room 1

# Billing Configuration
# Set ke 'false' untuk menonaktifkan billing di PC ini.
BILLING_ENABLED=true

# Browser Configuration
# 'true' untuk headless (tanpa GUI), 'false' untuk browser visible (PC ruangan pakai display).
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
# Browser args (delimiter: ||)
BROWSER_ARGS=--start-maximized||--kiosk||--disable-dev-shm-usage||--no-sandbox||--disable-blink-features=AutomationControlled||--disable-web-security||--disable-features=IsolateOrigins,site-per-process||--disable-setuid-sandbox

# Browser viewport (optional)
BROWSER_VIEWPORT=false
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# YouTube Configuration
YOUTUBE_HOME=https://www.youtube.com

# Health Check Configuration (interval dalam ms)
HEALTH_INTERVAL=5000

# Logging Configuration
LOG_LEVEL=info

# Server Configuration
# SERVER_IP adalah IP PC SERVER. Karena server dan agent jalan di PC yang sama,
# kosongkan agar otomatis pakai local IP (atau isi 127.0.0.1).
SERVER_IP=
SERVER_PORT=53331
