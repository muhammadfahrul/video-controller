# Room Configuration - WAJIB diisi beda-beda tiap room pas instalasi
ROOM_ID=room-001
ROOM_NAME=Room 1

# Billing Configuration
BILLING_ENABLED=true

# Browser Configuration
# Set 'true' buat headless (no GUI), 'false' buat visible browser
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
# Browser args (delimiter: ||)
BROWSER_ARGS=--start-maximized||--kiosk||--disable-dev-shm-usage||--no-sandbox||--disable-blink-features=AutomationControlled||--disable-web-security||--disable-features=IsolateOrigins,site-per-process||--disable-setuid-sandbox

BROWSER_VIEWPORT=false
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

YOUTUBE_HOME=https://www.youtube.com

HEALTH_INTERVAL=5000
LOG_LEVEL=info

# Server Configuration - WAJIB diisi IP server pusat pas instalasi
SERVER_PORT=53331
SERVER_IP=192.168.1.100

# Socket Auth - shared secret venue, HARUS sama persis dengan server/web/cashier
# Digenerate otomatis pas build release (lihat build.sh/build-release.sh), jangan isi manual
VC_SHARED_SECRET=REPLACE_WITH_GENERATED_SECRET
