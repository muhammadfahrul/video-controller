# Server Configuration - WAJIB diisi IP server pusat pas instalasi
VITE_SERVER_PORT=53331
VITE_SERVER_IP=192.168.1.100

# Billing Configuration
VITE_BILLING_ENABLED=true

# Socket Auth - shared secret venue, HARUS sama persis dengan agent/server/cashier
# Digenerate otomatis pas build release (lihat build.sh/build-release.sh), jangan isi manual
VITE_SHARED_SECRET=REPLACE_WITH_GENERATED_SECRET
