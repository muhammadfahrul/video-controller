# Billing Configuration (toggle global)
# Set to 'false' untuk menyembunyikan fitur billing di PC Kasir.
VITE_BILLING_ENABLED=true

# Room Configuration
# Topologi: 1 Ruangan = 1 PC server tersendiri. Setiap entry 'ip' = IP PC Ruangan tsb.
# roomId HARUS sama dengan ROOM_ID di agent/.env PC ruangan terkait.
#
# Contoh benar (3 ruangan di 3 PC terpisah):
# VITE_ROOMS=[
#   {"roomId":"room-001","name":"Room 1","ip":"192.168.1.104","port":53331,"pricePerHour":50000},
#   {"roomId":"room-002","name":"Room 2","ip":"192.168.1.114","port":53331,"pricePerHour":60000},
#   {"roomId":"room-003","name":"Room 3","ip":"192.168.1.12","port":53331,"pricePerHour":45000}
# ]
VITE_ROOMS=[{"roomId":"room-001","name":"Room 1","ip":"192.168.1.104","port":53331,"pricePerHour":50000},{"roomId":"room-002","name":"Room 2","ip":"192.168.1.114","port":53331,"pricePerHour":60000},{"roomId":"room-003","name":"Room 3","ip":"192.168.1.12","port":53331,"pricePerHour":45000}]
