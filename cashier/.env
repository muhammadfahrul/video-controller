# Billing Configuration (toggle global)
# Set to 'false' untuk menyembunyikan fitur billing di PC Kasir.
VITE_BILLING_ENABLED=true

# Room Configuration
# Topologi: 1 Ruangan = 1 PC server tersendiri. Setiap entry 'ip' = IP PC Ruangan tsb.
# roomId HARUS sama dengan ROOM_ID di agent/.env PC ruangan terkait.
# Tarif per jam (pricePerHour) TIDAK lagi diisi di sini - dikirim oleh server tiap
# ruangan (lihat PRICE_PER_HOUR di server/.env PC ruangan tsb).
#
# Contoh benar (3 ruangan di 3 PC terpisah):
# VITE_ROOMS=[{"roomId":"room-001","name":"Room 1","ip":"10.207.80.11","port":53331},{"roomId":"room-002","name":"Room 2","ip":"10.207.80.50","port":53331},{"roomId":"room-003","name":"Room 3","ip":"10.207.80.17","port":53331},{"roomId":"room-004","name":"Room 4","ip":"10.207.80.234","port":53331},{"roomId":"room-005","name":"Room 5","ip":"192.168.1.110","port":53331},{"roomId":"room-006","name":"Room 6","ip":"10.207.80.181","port":53331}]
VITE_ROOMS=[{"roomId":"room-001","name":"Room 1","ip":"10.207.80.11","port":53331},{"roomId":"room-002","name":"Room 2","ip":"10.207.80.50","port":53331},{"roomId":"room-003","name":"Room 3","ip":"10.207.80.17","port":53331},{"roomId":"room-004","name":"Room 4","ip":"10.207.80.234","port":53331},{"roomId":"room-005","name":"Room 5","ip":"192.168.1.110","port":53331},{"roomId":"room-006","name":"Room 6","ip":"10.207.80.181","port":53331}]
