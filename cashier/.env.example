# Billing Configuration
VITE_BILLING_ENABLED=true

# Room Configuration (multi-room)
# Format: JSON array of {name, ip, port, pricePerHour}
VITE_ROOMS=[{"name":"Room 1","ip":"192.168.1.101","port":53331,"pricePerHour":50000}]

# Socket Auth - shared secret venue (dipake sama buat SEMUA koneksi ke tiap room)
# HARUS sama persis dengan agent/server/web di semua room
# Digenerate otomatis pas build release (lihat build.sh/build-release.sh), jangan isi manual
VITE_SHARED_SECRET=REPLACE_WITH_GENERATED_SECRET
