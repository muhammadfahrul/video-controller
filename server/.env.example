# YouTube API Configuration
# JANGAN commit value asli ke git! Isi manual pas deploy di server pusat.
# Kalo key lama pernah ke-expose di public repo, WAJIB revoke & generate baru
# di Google Cloud Console dulu sebelum dipake lagi.
YOUTUBE_API_KEY=REPLACE_WITH_YOUR_OWN_KEY

# Server Configuration
PORT=53331
SERVER_IP=192.168.1.100

# Billing Configuration
BILLING_ENABLED=true

# Socket Auth - shared secret venue, HARUS sama persis dengan agent/web/cashier
# Digenerate otomatis pas build release (lihat build.sh/build-release.sh), jangan isi manual
VC_SHARED_SECRET=REPLACE_WITH_GENERATED_SECRET
