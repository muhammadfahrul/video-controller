# YouTube API Configuration
# Dapatkan dari https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Server Configuration
# Listen port untuk HTTP + Socket.IO. Semua PC ruangan pakai 53331.
PORT=53331

# Billing Configuration
# Set ke 'false' untuk menonaktifkan fitur billing di PC ini.
BILLING_ENABLED=true

# Tarif per jam ruangan ini (dalam Rupiah).
# WAJIB diisi beda tiap PC ruangan sesuai tarif ruangan tsb. PC Kasir tidak lagi
# menyimpan tarif sendiri - server tiap ruangan yang jadi sumber kebenaran, dikirim
# ke cashier lewat data agent (pricePerHour di AgentInfo).
PRICE_PER_HOUR=50000

# Daftar paket harga tetap untuk ruangan ini (opsional, JSON array).
# Kosongkan/hapus kalau ruangan ini tidak menawarkan paket - cashier hanya
# akan menampilkan opsi durasi bebas (hourly) seperti biasa.
# Kelebihan waktu di atas durasi paket tetap ditagih per jam sesuai PRICE_PER_HOUR.
# PACKAGES=[{"id":"p2j","name":"Paket 2 Jam","durationMinutes":120,"price":150000},{"id":"p3j","name":"Paket 3 Jam","durationMinutes":180,"price":210000}]
